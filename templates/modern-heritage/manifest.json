  "thumbnail": {"phone": ".mh-announcement,.mh-site-header{display:none!important}.mh-hero{min-height:720px!important}", "wide": ".mh-announcement,.mh-site-header,.mh-hero-inner,.mh-countdown-wrap{display:none!important}.mh-hero{min-height:275px!important;padding:0!important}.tpl-mh>*:not(.mh-hero){display:none!important}.mh-corner{width:128px!important;opacity:.9!important}"},
  "example": {"story": "Some stories are written in grand gestures. Others unfold in quiet conversations, familiar smiles, and the little moments that become everything.\n\nWe are grateful for the people who have been part of our journey, and we cannot wait to begin this next chapter surrounded by family and friends.", "events": [{"title": "Guest arrival", "venue": "We look forward to welcoming you."}, {"title": "Wedding ceremony", "venue": "Your ceremony venue"}, {"title": "Blessings & celebration", "venue": "More details will be shared soon."}], "photos": 3},
