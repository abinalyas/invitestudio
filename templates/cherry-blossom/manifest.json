  "thumbnail": {
    "phone": ".cb-site-header,.cb-intro,.cb-petal-layer,.cb-date-petals,.cb-date-hint{display:none!important}.cb-hero-content,.cb-hero-date{animation:none!important;opacity:1!important}.cb-hero-date{opacity:1!important;visibility:visible!important}",
    "wide": ".cb-site-header,.cb-intro,.cb-petal-layer,.cb-date-petals,.cb-date-hint{display:none!important}.tpl-cb>*:not(.cb-hero){display:none!important}.cb-hero{min-height:275px!important;height:275px!important}.cb-hero-content{animation:none!important;opacity:1!important}.cb-hero-date{opacity:1!important;visibility:visible!important}"
  },
  "example": {
    "story": "From a chance meeting to a thousand small moments, our story has become our favourite place to be. Now, with the people we love close by, we are ready for the next chapter.\n\nWe would be so happy to have you with us as we celebrate our families and dance into everything that comes next.",
    "events": [
      {
        "title": "The first gathering",
        "venue": "Your venue"
      },
      {
        "title": "The second gathering",
        "venue": "Your venue"
      }
    ],
    "photos": 3
  },
