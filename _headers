/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://images.unsplash.com; media-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# Fonts never change in place, so browsers may keep them for a year. Pictures may change under the same name
# (npm run thumbs:scenes), so they are kept for a day and refreshed in the background for a week after that.
/assets/scene-fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: same-site
/assets/hero/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  Cross-Origin-Resource-Policy: same-site
/assets/home/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  Cross-Origin-Resource-Policy: same-site
/assets/templates/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  Cross-Origin-Resource-Policy: same-site
/assets/samples/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  Cross-Origin-Resource-Policy: same-site
/assets/share-cards/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  Cross-Origin-Resource-Policy: same-site

# The designs' artwork, fonts and animations are for InviteStudio pages only: other sites cannot embed them in a browser
# (Cross-Origin-Resource-Policy, set above and below), and the full production files are kept out of image search. The
# gallery previews under /assets/templates stay open to search engines, which show them as thumbnails. See docs/PROTECTION.md.
/templates/:id/assets/*
  Cross-Origin-Resource-Policy: same-site
  X-Robots-Tag: noindex
/assets/music/*
  Cross-Origin-Resource-Policy: same-site
  X-Robots-Tag: noindex

# The owner's admin page: never indexed, never cached. Sign-in is checked on the server (docs/ADMIN.md).
/admin
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
/admin.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
/admin.js
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-cache
