{
  "name": "invitestudio",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "test:e2e": "playwright test",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:qa": "node qa-regression.js",
    "test:cloud": "playwright test -c playwright.cloud.config.js",
    "build:figma": "node figma/build.mjs",
    "check:figma": "tsc -p figma/tsconfig.json",
    "gen:templates": "node scripts/generate-template-registry.mjs",
    "build:scene-css": "node scripts/inline-scene-css.mjs",
    "build:templates": "node scripts/build-templates.mjs",
    "thumbs:scenes": "node scripts/generate-scene-thumbnails.mjs",
    "test:db": "node --test --test-concurrency=1 tests/db/*.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "18.6.0-beta.19",
    "esbuild": "0.28.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "wrangler": "4.157.0"
  }
}
